<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.github.kaission2.kunpo-ali-aar</groupId>
  <artifactId>kunpo_ali_auth_number</artifactId>
  <version>2.14.24</version>
  <packaging>pom</packaging>
  <properties>
    <auth.number.product.v>2.14.24</auth.number.product.v>
    <logger.v>2.2.2</logger.v>
    <main.v>2.2.3</main.v>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.github.kaission2.kunpo-ali-aar</groupId>
      <artifactId>auth_number_product</artifactId>
      <version>${auth.number.product.v}</version>
      <type>aar</type>
    </dependency>
    <dependency>
      <groupId>com.github.kaission2.kunpo-ali-aar</groupId>
      <artifactId>logger</artifactId>
      <version>${logger.v}</version>
      <type>aar</type>
    </dependency>
    <dependency>
      <groupId>com.github.kaission2.kunpo-ali-aar</groupId>
      <artifactId>main</artifactId>
      <version>${main.v}</version>
      <type>aar</type>
    </dependency>
  </dependencies>
</project>
